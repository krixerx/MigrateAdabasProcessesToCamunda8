# Adabas -> Camunda 8 in-flight migration POC
#
# Ports are deliberately NOT the Camunda defaults. The sibling POC holds
# 8080 / 26500 / 9600 / 5432 on this machine, and the two projects are
# required to know nothing about each other (design doc, Constraints).
# Both stacks must be able to run side by side.

CAMUNDA_VERSION=8.9.12
POSTGRES_VERSION=17-alpine

# Host ports
CAMUNDA_HTTP_PORT=18080
CAMUNDA_GRPC_PORT=36500
CAMUNDA_MGMT_PORT=19600
POSTGRES_PORT=15432

# Bind to loopback only. Set to empty to expose on all interfaces.
PRIVATE_BIND=127.0.0.1:

# Postgres. One server, two schemas:
#   migration  - the migration ledger (ours)
#   camunda    - Camunda secondary storage (the engine's)
POSTGRES_DB=migration
POSTGRES_USER=migration
POSTGRES_PASSWORD=migration
